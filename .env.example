# ===== Telegram =====
# 从 @BotFather 拿到的 Token
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUvwxyZ

# Telegram 出网代理(国内服务器需要,境外服务器留空即可)
# 例: http://127.0.0.1:7890  或  socks5://user:pwd@host:1080
TG_PROXY=

# ===== 小米 MiMo 大模型 =====
MIMO_AUTH_STYLE=xiaomi
MIMO_API_KEY=sk-xxxxxxxxxxxxxxxx

# 集群地址三选一(根据服务器位置选最近的):
#   中国:    https://token-plan-cn.xiaomimimo.com/v1
#   新加坡:  https://token-plan-sgp.xiaomimimo.com/v1   ← 美国/亚洲服务器推荐
#   欧洲:    https://token-plan-ams.xiaomimimo.com/v1
MIMO_BASE_URL=https://token-plan-sgp.xiaomimimo.com/v1

MIMO_MODEL=mimo-v2.5-pro

# MiMo 出网代理(一般不需要,留空)
MIMO_PROXY=

# 可选参数
MIMO_TEMPERATURE=0.7
MIMO_MAX_TOKENS=1024
MIMO_HISTORY_TURNS=8
